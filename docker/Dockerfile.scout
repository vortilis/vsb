# VorPilot Server backend image around a pre-built binary.
# The build context holds scout-linux-<arch> for every platform being built.
# Cluster credentials are provided at runtime (see the Helm chart).
ARG ANP_PROXY_SERVER_IMAGE=registry.k8s.io/kas-network-proxy/proxy-server:v0.35.0@sha256:96df21e70519a6b65b2b2b1a4647dd76e89202b4b1a23f470ccec208b4cee1d6
ARG ANP_PROXY_AGENT_IMAGE=registry.k8s.io/kas-network-proxy/proxy-agent:v0.35.0@sha256:85b9fb116fbedfcba0243068234fba5f78fd4d45791286b6b74656e60af0c2f5
FROM ${ANP_PROXY_SERVER_IMAGE} AS anp-server
FROM ${ANP_PROXY_AGENT_IMAGE} AS anp-agent
# Pinned by index digest, so the base cannot change between a scan and a
# publish. Bump tag and digest together.
FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

RUN apk add --no-cache ca-certificates tzdata

# TARGETARCH is set by BuildKit from --platform. --chmod: a binary downloaded
# as a release asset arrives without its executable bit.
ARG TARGETARCH
COPY --chmod=0755 scout-linux-${TARGETARCH} /usr/local/bin/scout
COPY --from=anp-server /proxy-server /usr/local/bin/proxy-server
COPY --from=anp-agent /proxy-agent /usr/local/bin/proxy-agent

EXPOSE 50051

ENTRYPOINT ["scout"]
